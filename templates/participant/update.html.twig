{% extends 'base.html.twig' %}

{% block title %}Modifier mon profil{% endblock %}

{% block body %}
    <div class="h4 pb-2 mb-4 text-secondary border-bottom border-secondary" style="margin-top: 1rem">
        <h1 class="text-center">Mon profil</h1>
    </div>
    <div class="container">
        <div class="card">
            <div class="card-body">
                {{ form_start(form) }}

                    <div class="mb-3">
                        {{ form_row(form.username) }}
                    </div>
                    <div class="mb-3">
                        {{ form_row(form.prenom) }}
                    </div>
                    <div class="mb-3">
                        {{ form_row(form.nom) }}
                    </div>
                    <div class="mb-3">
                        {{ form_row(form.telephone) }}
                    </div>
                    <div class="mb-3">
                        {{ form_row(form.mail) }}
                    </div>
                    <div class="mb-3">
                        {{ form_row(form.plainPassword) }}
                    </div>
                    <div class="mb-3">
                        {{ form_row(form.site) }}
                    </div>
                    <button type="submit" class="btn btn-primary" >Enregistrer</button>
                    <a role="button" class="btn btn-warning" href="{{ path('sorties_list') }}">Annuler</a>

                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}
