{% extends 'base.html.twig' %}

{% block title %}Nouveau participant{% endblock %}

{% block body %}
    <div class="container">
    <h1 class="text-center">Mon Profil</h1>

    {{ form_start(form) }}

        <div class="mb-3">
            {{ form_row(form.username) }}
        </div>
        <div class="mb-3">
            {{ form_row(form.prenom) }}
        </div>
        <div class="mb-3">
            {{ form_row(form.nom) }}
        </div>
        <div class="mb-3">
            {{ form_row(form.telephone) }}
        </div>
        <div class="mb-3">
            {{ form_row(form.mail) }}
        </div>
        <div class="mb-3">
            {{ form_row(form.plainPassword) }}
        </div>
        <div class="mb-3">
            {{ form_row(form.site) }}
        </div>
        <button type="submit" class="btn btn-primary" >Enregistrer</button>
        <a role="button" class="btn btn-warning" href="{{ path('sorties_list') }}">Annuler</a>

    {{ form_end(form) }}

    </div>
{% endblock %}
