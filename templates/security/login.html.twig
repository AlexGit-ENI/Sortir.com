{% extends 'base.html.twig' %}

{% block title %}Sortir.com - Connexion{% endblock %}

{% block stylesheets %}

{% endblock %}

{% block body %}
    <div class="h4 pb-2 mb-4 text-secondary border-bottom border-secondary" style="margin-top: 1rem">
        <h1 class="text-center">Connexion</h1>
    </div>
    <div class="container">
        {% if error %}
            <div class="alert alert-warning" role="alert">
            Identifiants incorrets, veuillez réessayer.
            </div>
        {% endif %}
        <div class="card">
            <div class="card-body">
                <form action="{{ path('app_login') }}" method="post">
                    <div class="mb-3">
                        <label for="username" class="form-label">Identifiant</label>
                        <input type="text" id="username" name="_username" value="{{ last_username }}" autocomplete="username" class="form-control" required>
                    </div>

                    <div class="mb-3">
                        <label for="password" class="form-label">Mot de passe</label>
                        <input type="password" id="password" name="_password" autocomplete="current-password" class="form-control" required>
                    </div>

                    <div class="mb-3 form-check">
                        <input type="checkbox" id="remember_me" name="_remember_me" class="form-check-input">
                        <label for="remember_me" class="form-check-label">Se souvenir de moi</label>
                    </div>

                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                    <button type="submit" class="btn btn-primary">Se connecter</button>
                </form>
            </div>
        </div>
    </div>
{% endblock %}
