{% extends 'base.html.twig' %}

{% block title %} Détail de la sortie {% endblock %}

{% block body %}

<main>
    <h1> Détail de la sortie</h1>

    <label>Nom de la sortie : </label>
    <span> {{ sortie.nom }}</span>
    <br>

    <label>Date et heure de la sortie : </label>
    <span>{{ sortie.dateHeureDebut }}</span>
    <br>

    <label>Date limite de l'inscription : </label>
    <span> {{ sortie.dateLimiteInscription }}</span>
    <br>

    <label>Nombre de places disponibles : </label>
    <span> {{ sortie.listeParticipants }}</span>
    <br>

    <label> Durée : </label>
    <span> {{ sortie.duree }}</span>
    <br>

    <label> Description et infos : </label>
    <span> {{ sortie.description }}</span>
    <br>

    <label> Ville Organisatrice : </label>
    <span> {{ sorties.lieu.ville }}</span>
    <br>

    <label> Lieu : </label>
    <span> {{ lieu.nom }}</span>
    <br>

    <label> Code Postal : </label>
    <span> lieu.ville.codePostal</span>
    <br>

    <label> Latitude : </label>
    <span> {{ sortie.lieu.latitude }}</span>
    <br>

    <label> Longitude : </label>
    <span> {{ sortie.lieu.longitude }}</span>
    <br>

    <h1> Liste des participants inscrits à l'évenement : </h1>

    <table class="{{ sortie.listeParticipants }}"></table>

    <tr>
        <th>Pseudo</th>
        <th>Nom</th>
    </tr>

    <tbody>
    {% for participant in sortie.participants %}
    </tbody>

























</main>
