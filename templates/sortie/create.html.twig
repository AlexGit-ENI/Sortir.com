{% extends 'base.html.twig' %}

{% block body %}
    <main>
    <div class="container">
        <h1 class="text-center">Créer une sortie</h1>
        {{ form_start(createSortieForm) }}
            <div class="mb-3">
                {{ form_row(createSortieForm.nom) }}
            </div>
            <div class="mb-3">
                {{ form_row(createSortieForm.dateHeureDebut) }}
            </div>
            <div class="mb-3">
                {{ form_row(createSortieForm.dateLimiteInscription) }}
            </div>
            <div class="mb-3">
                {{ form_row(createSortieForm.nbInscriptionsMax) }}
            </div>
            <div class="mb-3">
                {{ form_row(createSortieForm.duree) }}
            </div>
            <div class="mb-3">
                {{ form_row(createSortieForm.description) }}
            </div>
            <div class="mb-3">
                {{ form_row(createSortieForm.lieu) }}
            </div>
            <button type="submit" class="btn btn-primary">Créer</button>
            {{ form_row(createSortieForm._token) }}
        {{ form_end(createSortieForm) }}
    </div>
    </main>
{% endblock %}

