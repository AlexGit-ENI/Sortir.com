{% extends 'base.html.twig' %}

{% block title %}Toutes les sorties{% endblock %}

{% block body %}

    <main>

        <h1>Toutes les sorties à venir</h1>

        <form action="" method="get" id="event-search" class="search-form">

            <p>
                <label for="site">Ville : </label>
                <input type="text" name="site" class="form-control" value="{{ site }}">
           </p>

            <input type="submit" class="action-btn" value="Rechercher">

        </form>

        <div id="sortie-list">
            {% if sorties %}
                {% for sortie in sorties %}

                    <article class="sortie-article">
                        <h2>{{ sortie.nom }}</h2>
                        <div class="sortie-meta">
                            <p><i>📆 </i><time>{{ sortie.dateHeureDebut | format_datetime('full', 'medium', locale='fr') }}</time></p>
                            <p><i>⏱️ </i>Durée : {{ sortie.duree }} h</p>
                            <p> Places disponibles : {{ sortie.nbInscriptionsMax }}</p>
                        </div>
                        <p>
                            {{ sortie.description }}
                        </p>
                    </article>

                {% endfor %}
            {% else %}
                <p>Aucune sortie n'a été trouvée</p>
            {% endif %}

        </div>

    </main>

{% endblock %}
