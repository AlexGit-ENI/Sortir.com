{% extends 'base.html.twig' %}

{% block title %}Toutes les sorties{% endblock %}

{% block body %}

    <main>

        <h1>Toutes les sorties à venir</h1>

        <!-- filtre par site -->
        {# ajouter un bouton HTML simple au lieu d'un créé avec le fomr pour qu'il ne figure pas dans l'URL  #}
        {{ form_start(filterSortieListForm) }}
        {{ form_row(filterSortieListForm.site) }}
        {{ form_row(filterSortieListForm.search) }}
        {{ form_row(filterSortieListForm.dateMin) }}
        {{ form_row(filterSortieListForm.dateMax) }}
        {{ form_row(filterSortieListForm.checkboxes) }}


        <button type="submit">Rechercher</button>
        {{ form_end(filterSortieListForm) }}

        <div id="sortie-list">
            {% if sorties %}
                {% for sortie in sorties %}

                    <article class="sortie-article">
                        <h2>{{ sortie.nom }}</h2>
                        <div class="sortie-meta">
                            <p><i>📆 </i><time>{{ sortie.dateHeureDebut | date('d/m/Y H:i') }}</time></p>
                            <p><i>⏱️ </i>Durée : {{ sortie.duree }} minutes</p>
                            <p>Organisé par le site de : {{ sortie.site.nom }} - Organisateur : <a href="{{ path('participant_detail', {id : sortie.organisateur.id}) }}">{{ sortie.organisateur.username }}</a></p>
                            <p>Lieu : {{ sortie.lieu.nom }}</p>
                            <p>Ville : {{ sortie.lieu.ville.nom }}</p>
                            <p> Inscriptions : {{ sortie.listeParticipants|length }} / {{ sortie.nbInscriptionsMax }}</p>
                        </div>
                        <p>{{ sortie.description }}</p>
                        <p> Statut :  {{ sortie.etatSortie.value }}</p>

                        {% if sortie.etatSortie == constant('App\\Enum\\EtatSortie::OPEN')%}
                            {% if not (app.user in sortie.listeParticipants) %}
                                <a href="{{ path('sorties_inscription', {'id': sortie.id}) }}">S'inscrire ici</a>
                            {% else %}
                                <a href="{{ path('sorties_desister', {'id': sortie.id}) }}">Se désister ici</a>
                            {%endif%}
                        {%endif%}
                        {% if app.user == sortie.organisateur and sortie.etatSortie != constant('App\\Enum\\EtatSortie::CURRENT') %}
                            <a href="{{ path('sorties_annuler', {'id': sortie.id}) }}">Annuler la sortie</a>
                        {% endif %}
                        {% if sortie.etatSortie == constant('App\\Enum\\EtatSortie::CREATED') and app.user == sortie.organisateur %}
                            <a href="{{ path('sorties_update', {'id': sortie.id}) }}">Modifier</a>
                            <a href="{{ path('sorties_open', {'id': sortie.id}) }}">Publier</a>
                        {% endif %}
                        <a href="{{ path('sorties_detail', {'id': sortie.id}) }}">Détail de la sortie</a>

                    </article>

                {% endfor %}
            {% else %}
                <p>Aucune sortie n'a été trouvée</p>
            {% endif %}
        </div>

    </main>

{% endblock %}
