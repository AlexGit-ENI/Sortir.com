{% extends 'base.html.twig' %}

{% block title %}Toutes les sorties{% endblock %}

{% block body %}

    <main>

        <h1>Toutes les sorties à venir</h1>

        <!-- filtre par site -->
        {# ajouter un bouton HTML simple au lieu d'un créé avec le fomr pour qu'il ne figure pas dans l'URL  #}
        {{ form_start(siteSelectForm) }}
        {{ form_row(siteSelectForm.site) }}
        <button type="submit">Rechercher</button>
        {{ form_end(siteSelectForm) }}

        <div id="sortie-list">
            {% if sorties %}
                {% for sortie in sorties %}

                    <article class="sortie-article">
                        <h2>{{ sortie.nom }}</h2>
                        <div class="sortie-meta">
                            <p><i>📆 </i><time>{{ sortie.dateHeureDebut | format_datetime('full', 'medium', locale='fr') }}</time></p>
                            <p><i>⏱️ </i>Durée : {{ sortie.duree }} h</p>
                            <p>Organisée par le site de : {{ sortie.site.nom }} - Organisateur : <a href="{{ path('participant_detail', {id : sortie.organisateur.id}) }}">{{ sortie.organisateur.username }}</a></p>
                            <p>Lieu : {{ sortie.lieu.nom }}</p>
                            <p>Ville : {{ sortie.lieu.ville.nom }}</p>
                            <p> Nombre de participants max : {{ sortie.nbInscriptionsMax }}</p>
                        </div>

                        <p>
                            {{ sortie.description }}</p>
                        <p> Nombre d'inscrits {{ sortie.listeParticipants|length }} </p>

                      {% if not (app.user in sortie.listeParticipants) %}
                          <a href="{{ path('sorties_inscription', {'id': sortie.id}) }}">S'inscrire ici</a>
                      {% else %}
                          <a href="{{ path('sorties_desister', {'id': sortie.id}) }}">Se désister ici</a>
                      {% endif %}

                    </article>

                {% endfor %}
            {% else %}
                <p>Aucune sortie n'a été trouvée</p>
            {% endif %}
        </div>

    </main>

{% endblock %}
