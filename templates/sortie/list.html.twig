{% extends 'base.html.twig' %}

{% block title %}Toutes les sorties{% endblock %}

{% block body %}

    <main>

        <h1>Toutes les sorties à venir</h1>

        <!-- filtre par site -->
        {# ajouter un bouton HTML simple au lieu d'un créé avec le fomr pour qu'il ne figure pas dans l'URL  #}
        {{ form_start(siteSelectForm) }}
        {{ form_row(siteSelectForm.site) }}
        <button type="submit">Rechercher</button>
        {{ form_end(siteSelectForm) }}

        <div class="row row-cols-1 row-cols-md-3 g-4">
            {% if sorties %}
                {% for sortie in sorties %}
            <div class="col">
                    <div class="card text-center w-100">
                        <div class="card-header">
                            <ul class="nav nav-tabs card-header-tabs">
                                <li class="nav-item">
                                    <a class="nav-link active" aria-current="true" href="{{ path('sorties_detail', {'id': sortie.id}) }}">Detail</a>
                                </li>
                                {% if sortie.etatSortie == constant('App\\Enum\\EtatSortie::CREATED') and app.user == sortie.organisateur %}
                                <li class="nav-item">
                                    <a class="nav-link" href="{{ path('sorties_update', {'id': sortie.id}) }}">Modifier</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="{{ path('sorties_open', {'id': sortie.id}) }}">Publier</a>
                                </li>
                                {% endif %}
                                <li class="nav-item">
                                    <a class="nav-link disabled" aria-disabled="true">{{ sortie.etatSortie.value }}</a>
                                </li>
                            </ul>
                        </div>
                        <div class="card-body">
                            <h5 class="card-title">{{ sortie.nom }}</h5>


                            <p class="card">
                                <ul class="list-group list-group-flush">
                                    <li class="list-group-item">Débute le {{ sortie.dateHeureDebut | date('d/m/Y H:i') }}</li>
                                    <li class="list-group-item">A {{ sortie.lieu.nom }} dans la ville de {{ sortie.lieu.ville.nom }}</li>
                                    <li class="list-group-item">Dure {{ sortie.duree }} minutes</li>
                                    <li class="list-group-item">Par <a href="{{ path('participant_detail', {id : sortie.organisateur.id}) }}">{{ sortie.organisateur.username }}</a> du site de {{ sortie.site.nom }}</li>
                                    <li class="list-group-item">Inscriptions : {{ sortie.listeParticipants|length }} / {{ sortie.nbInscriptionsMax }}</li>
                                </ul>
                                <div class="card-footer">
                                    Inscriptions jusqu'au {{ sortie.dateLimiteInscription | date('d/m/Y H:i') }}
                                </div>
                            </p>


                            {% if sortie.etatSortie == constant('App\\Enum\\EtatSortie::OPEN') or sortie.etatSortie == constant('App\\Enum\\EtatSortie::CLOSED') %}
                                {% if not (app.user in sortie.listeParticipants) %}
                                    {% if sortie.etatSortie == constant('App\\Enum\\EtatSortie::OPEN') %}
                                        <a class="btn btn-primary" href="{{ path('sorties_inscription', {'id': sortie.id}) }}">S'inscrire</a>
                                    {% endif %}
                                {% else %}
                                    <a class="btn btn-danger" href="{{ path('sorties_desister', {'id': sortie.id}) }}">Se désister</a>
                                {% endif %}
                            {% endif %}
                        </div>
                    </div>
            </div>
                {% endfor %}
            {% endif %}

        </div>

    </main>
{% endblock %}
