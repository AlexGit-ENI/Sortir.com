    {% if is_granted('IS_AUTHENTICATED_FULLY') %}
    <nav class="navbar navbar-expand-lg bg-body-tertiary">
        <div class="container-fluid">
            <a class="navbar-brand" href="{{ path('sorties_list') }}">Sortir.com</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavDropdown" aria-controls="navbarNavDropdown" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNavDropdown">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link active" aria-current="page" href="{{ path('sorties_list') }}">Accueil</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('sorties_create') }}">Créer sortie</a>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Mon profil
                        </a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="{{ path('participant_update', {id : app.user.id}) }}">Modifier mon profil</a></li>
                            <li><a class="dropdown-item" href="{{ path('participant_detail', {id : app.user.id}) }}">Voir mon profil</a></li>
                        </ul>
                    </li>
                    {% if is_granted('ROLE_ADMIN') %}
                        <li class="nav-item">
                            <a class="nav-link" aria-current="page" href="{{ path('sorties_archives') }}">Archives</a>
                        </li>
                    {% endif %}
                </ul>
                <a class="btn btn-outline-secondary d-flex" href="{{ path('app_logout') }}" role="button">Se déconnecter</a>
            </div>
        </div>
    </nav>
    {% endif %}

</header>
